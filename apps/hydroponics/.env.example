# このファイルの役割：水耕栽培アプリ専用の環境設定の見本です。
# PCで共通の入口から動かすだけなら、このファイルのコピーは不要です。
# ラズパイでは .env にコピーし、HYDRO_USE_DUMMY を false にします。

# 単体起動時の戻り先（ブラウザから到達できるダッシュボードのURL）
HYDRO_DASHBOARD_URL=

# 単体起動時のポート番号
HYDRO_PORT=8001

# true ならダミーセンサー、false なら実センサーを使う（ラズパイでは false にする）
HYDRO_USE_DUMMY=true

# 生育段階。germination（発芽まで）→ seedling（発芽〜本葉）→ growing（本葉〜収穫）の順に、
# 栽培リーダーが生育を見て書き換える。書き換えたら `sudo systemctl restart dashboard` で画面に反映する
HYDRO_STAGE=germination
